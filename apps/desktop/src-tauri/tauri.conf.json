{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asterism",
  "identifier": "dev.asterism.desktop",
  "build": {
    "beforeDevCommand": "npm run sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecars -- --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "asterism", "width": 1280, "height": 820, "minWidth": 800, "minHeight": 500, "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/asterismd", "binaries/asterism", "binaries/asterism-plugin-claude", "binaries/asterism-plugin-github", "binaries/asterism-plugin-linear"],
    "macOS": { "signingIdentity": "-" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQjMwQjUzMzEyNDhCODcKUldTSGl5UXhVd3V6c0VsMDB6aUZKRFNXRU1yUnBXdTBJTDBsVVlRWTV0eG1ZbVNMaHNsa1VOckgK",
      "endpoints": ["https://github.com/asterism-dev/asterism/releases/latest/download/latest.json"]
    }
  }
}
